# PayGuard Agent Environment Configuration
# Copy this file to .env before starting the application.

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
# Master password for accessing the PayGuard dashboard
APP_PASSWORD=payguard2026!
# Secret key used for signing session cookies
SESSION_SECRET=payguard-agent-super-secret-key-change-in-production-32chars

# PayPal Configuration
# Mode: 'mock' (zero credentials required) or 'sandbox' (real PayPal Sandbox)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: PayPal Webhook ID for signature verification
PAYPAL_WEBHOOK_ID=

# AI (Google Gemini) Configuration
# If GEMINI_API_KEY is not set, PayGuard automatically uses the deterministic keyword reader fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Policy & Thresholds
# Amounts (USD) over this require explicit numeric confirmation by the approver
APPROVAL_LIMIT=500
# Amounts (USD) over this are hard blocked in-app and require manual out-of-band wire
HARD_LIMIT=5000

# Persistence
DB_PATH=./data/payguard.db

# Seed / Sandbox test recipients (comma-separated sandbox buyer/personal emails)
SEED_RECIPIENTS=sb-buyer1@business.example.com,sb-buyer2@personal.example.com
