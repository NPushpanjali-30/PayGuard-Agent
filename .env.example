# PayGuard Agent Environment Configuration
# Copy this file to .env before starting the application.

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
# Master password for accessing the PayGuard dashboard (fallback if APPROVERS is unset)
APP_PASSWORD=payguard2026!
# Multi-approver identities: comma-separated username:password pairs (e.g. alice:password1,bob:password2)
APPROVERS=
# Application base URL used to construct public confirmation links
APP_BASE_URL=http://localhost:3000
# Secret key used for signing session cookies
SESSION_SECRET=payguard-agent-super-secret-key-change-in-production-32chars

# PayPal Configuration
# Mode: 'mock' (zero credentials required) or 'sandbox' (real PayPal Sandbox)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: PayPal Webhook ID for signature verification
PAYPAL_WEBHOOK_ID=

# AI (Google Gemini) Configuration
# If GEMINI_API_KEY is not set, PayGuard automatically uses the deterministic keyword reader fallback
GEMINI_API_KEY=
# Google Gemini model ID for email and invoice extraction
GEMINI_MODEL=gemini-3.8-flash

# Policy & Thresholds
# Amounts (USD) over this require explicit numeric confirmation by the approver
APPROVAL_LIMIT=500
# Amounts (USD) over this are hard blocked in-app and require manual out-of-band wire
HARD_LIMIT=5000

# Persistence
DB_PATH=./data/payguard.db

# Seed / Sandbox test recipients (comma-separated sandbox buyer/personal emails)
SEED_RECIPIENTS=sb-buyer1@business.example.com,sb-buyer2@personal.example.com

# Out-of-band Vendor Confirmation
# Expiration time in hours for out-of-band vendor confirmation tokens
CONFIRMATION_TTL_HOURS=24

# Email Delivery (Optional: if unset, PayGuard runs in zero-credential Demo Outbox mode)
# Outbound SMTP server hostname (if unset, runs in zero-credential Demo Outbox mode)
SMTP_HOST=
# Outbound SMTP server port
SMTP_PORT=587
# Outbound SMTP username for authentication
SMTP_USER=
# Outbound SMTP password for authentication
SMTP_PASS=
# Outbound SMTP sender email address
SMTP_FROM=

# Dual-Person Approval & Cooling-Off Period
# Amount in USD above which two distinct human approvers are required
DUAL_APPROVAL_THRESHOLD=1000
# Holding period in hours for payees with no prior payment history
NEW_PAYEE_COOLING_OFF_HOURS=24
# Demo mode flag enabling the 'Demo: skip waiting' button for cooling-off in development
DEMO_FAST_FORWARD=false

# Zapier / Webhook Intake API Key (Route disabled if unset)
# Secret API key for incoming Zapier/webhook email intake (route disabled if unset)
INTAKE_API_KEY=
